# Copier en .env (jamais commité). Valeurs ci-dessous = placeholders.
# Pas de commentaire en fin de ligne : Docker les intégrerait à la valeur.

DEALARR_WATCHLIST=watchlist.yaml
DEALARR_DB=data/dealarr.db
# Mode "run" : minutes entre deux cycles (± jitter en %)
DEALARR_INTERVAL_MINUTES=180
DEALARR_JITTER_PCT=15
# Secondes entre deux requêtes vers un même site
DEALARR_DOMAIN_DELAY=4-10
# Échecs consécutifs avant alerte technique
DEALARR_FAILURE_THRESHOLD=3
# true uniquement avec l'image "browser" (Playwright)
DEALARR_BROWSER=false
DEALARR_LOG_LEVEL=INFO

# Canaux de notification, séparés par des virgules : console, ntfy
DEALARR_NOTIFIERS=console

# --- ntfy (seconde étape) ---
# NTFY_URL=https://ntfy.example.lan
# NTFY_TOPIC=dealarr
# NTFY_TOPIC_SYSTEM=dealarr-system
# NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ou : NTFY_USER=dealarr et NTFY_PASSWORD=<mot-de-passe>

# --- Keepa (optionnel, API payante) ---
# KEEPA_API_KEY=<cle-keepa>
